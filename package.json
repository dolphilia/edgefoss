{
  "name": "edgefoss",
  "version": "0.0.0",
  "private": true,
  "description": "A portable, realm-aware SCM designed for Cloudflare Workers",
  "license": "Apache-2.0 OR MIT",
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=24 <25",
    "pnpm": ">=10.10.0 <11"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm rust:lint && pnpm vectors:check && pnpm docs:check",
    "docs:check": "node tools/check-doc-links.mjs",
    "cloud:plan": "node tools/cloud-plan.mjs",
    "format": "prettier --write . && cargo fmt --all",
    "format:check": "prettier --check . && cargo fmt --all --check",
    "test": "pnpm test:ts && pnpm test:cloud-plan && pnpm test:rust && pnpm test:static",
    "test:cloud-plan": "node --test tools/cloud-plan.test.mjs",
    "test:rust": "cargo test --workspace --all-targets",
    "test:static": "node tools/smoke-static-assets.mjs",
    "test:ts": "pnpm --filter @edgefoss/protocol test && pnpm --filter @edgefoss/worker test",
    "typecheck": "pnpm --filter @edgefoss/protocol typecheck && pnpm --filter @edgefoss/worker typecheck",
    "types": "pnpm --filter @edgefoss/worker types",
    "vectors:check": "node tools/audit-vectors.mjs && node tools/read-bundle-vector.mjs spec/vectors/bundle-v0.json",
    "rust:lint": "cargo clippy --workspace --all-targets --all-features -- -D warnings"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "wrangler": "^4.125.0"
  }
}
