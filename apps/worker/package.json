{
  "name": "@edgefoss/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@edgefoss/protocol": "workspace:*"
  },
  "scripts": {
    "build": "wrangler deploy --dry-run --env=\"\" --outdir dist",
    "check:startup": "wrangler check startup --env=\"\"",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p test/tsconfig.json",
    "types": "wrangler types src/worker-configuration.d.ts"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.0.0",
    "vitest": "^4.1.11"
  }
}
